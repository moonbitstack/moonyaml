# `.gitignore` keeps `!.git*` so that .gitignore, .github and .gitattributes stay
# tracked; that same negation would otherwise pull the whole `.git` directory —
# object database included — into the published tarball.
.git/
_build/
target/

# The site and the two scripts that feed it are for the repository, not for a
# caller who has just added the module: `moon add` should bring the library, the
# examples and the interface, and nothing else.
.ref/
docs/
scripts/
tools/
